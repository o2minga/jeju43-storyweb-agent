# Supabase project settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only. Bypasses Row Level Security — never expose to the browser
# or prefix with NEXT_PUBLIC_. Used for agent/pipeline writes (e.g. server
# actions, route handlers) that need to bypass RLS.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# 팀·함께공 전용 비공개 미리보기 게이트 (정식 로그인 시스템이 아님 — 이 값 하나와
# 비교만 하는 단순 비밀번호). 사이트 전체(src/proxy.ts)와 /api/preview/* 라우트가
# 이 값을 참조한다. 절대 실제 값을 커밋하지 말고 각자 .env.local에서만 채울 것.
PREVIEW_PASSWORD=change-me

# agent/(파이썬 파이프라인) 전용. Claude 호출(01/02/07/08)에 필요.
ANTHROPIC_API_KEY=sk-ant-your-key

# 03-visual(미술감독) 이미지 자동 생성 — Cloudflare Workers AI(flux-1-schnell).
# Cloudflare 대시보드 > Workers AI에서 발급. 없거나 호출이 실패하면 관리자 수동
# 생성(assets/{location_id}/{prompt_id}.png)으로 자동 폴백하므로 필수는 아니다.
CLOUDFLARE_ACCOUNT_ID=your-cloudflare-account-id
CLOUDFLARE_API_TOKEN=your-cloudflare-api-token

# 04-audio(음향감독) 내레이션 TTS는 Windows에 내장된 SAPI(오프라인, 키 불필요)를
# 그대로 쓴다 — 별도 API 키 없이 Windows에서만 동작하며, 다른 OS/음성 미설치 시
# 자동으로 placeholder로 폴백한다. 여기엔 채울 값이 없다.
